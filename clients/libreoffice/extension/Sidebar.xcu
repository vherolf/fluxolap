<?xml version="1.0" encoding="UTF-8"?>
<!-- The fluxolap deck in Calc's sidebar, with one panel (fluxolap_sidebar.py). -->
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry" xmlns:xs="http://www.w3.org/2001/XMLSchema" oor:name="Sidebar" oor:package="org.openoffice.Office.UI">
  <node oor:name="Content">
    <node oor:name="DeckList">
      <node oor:name="FluxolapDeck" oor:op="replace">
        <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">fluxolap</value></prop>
        <prop oor:name="Id" oor:type="xs:string"><value>FluxolapDeck</value></prop>
        <prop oor:name="IconURL" oor:type="xs:string"><value>vnd.sun.star.extension://org.fluxolap.calc/icons/deck.png</value></prop>
        <prop oor:name="ContextList"><value oor:separator=";">Calc, any, visible ;</value></prop>
        <prop oor:name="OrderIndex" oor:type="xs:int"><value>900</value></prop>
      </node>
    </node>
    <node oor:name="PanelList">
      <node oor:name="FluxolapPanel" oor:op="replace">
        <prop oor:name="Title" oor:type="xs:string"><value xml:lang="en-US">fluxolap</value></prop>
        <prop oor:name="Id" oor:type="xs:string"><value>FluxolapPanel</value></prop>
        <prop oor:name="DeckId" oor:type="xs:string"><value>FluxolapDeck</value></prop>
        <prop oor:name="ContextList"><value oor:separator=";">Calc, any, visible ;</value></prop>
        <prop oor:name="ImplementationURL" oor:type="xs:string"><value>private:resource/toolpanel/org.fluxolap.calc.PanelFactory/Main</value></prop>
        <prop oor:name="OrderIndex" oor:type="xs:int"><value>100</value></prop>
      </node>
    </node>
  </node>
</oor:component-data>
